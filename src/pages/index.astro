---
// Sparklin Shoe Care — Landing Page
// Composed from modular section components. Page content: src/data/site.ts

import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FloatingWhatsApp from '../components/FloatingWhatsApp.astro';
import Hero from '../components/sections/Hero.astro';
import About from '../components/sections/About.astro';
import Services from '../components/sections/Services.astro';
import BeforeAfter from '../components/sections/BeforeAfter.astro';
import Pricing from '../components/sections/Pricing.astro';
import WhyUs from '../components/sections/WhyUs.astro';
import Testimonials from '../components/sections/Testimonials.astro';
import Cta from '../components/sections/Cta.astro';
---

<Layout
  title="Sparklin Shoe Care — Step up, Stand out."
  description="Jasa cuci dan restorasi sepatu profesional di Bandung. Teknik ramah lingkungan, pengerjaan cepat, dan harga bersahabat untuk mahasiswa & urban sneakerheads."
>
  <Header />

  <main id="konten">
    <Hero />
    <About />
    <Services />
    <BeforeAfter />
    <Pricing />
    <WhyUs />
    <Testimonials />
    <Cta />
  </main>

  <Footer />
  <FloatingWhatsApp />
</Layout>
