    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .stat-number {
    font-size: 1.8rem;
    font-weight: 800;
    color: #ffffff;
  }

  .stat-label {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: #a7bfae;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  /* 3 PILLARS */
  .pillars-card {
    background: var(--color-bg-card);
    border-radius: 24px;
    padding: 44px;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 36px;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.15);
  }

  .pillar-column {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .pillar-divider {
    border-inline: 1px solid rgba(27, 56, 34, 0.1);
    padding-inline: 36px;
  }

  .pillar-header {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .pillar-icon {
    width: 42px;
    height: 42px;
    border-radius: 12px;
    background: rgba(27, 56, 34, 0.08);
    display: grid;
    place-items: center;
    color: var(--color-dark-green);
  }

  .pillar-title {
    font-size: 1.25rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    color: var(--color-dark-green);
  }

  .pillar-body {
    font-size: 0.92rem;
    line-height: 1.65;
    color: var(--color-text-muted);
  }

  /* ==========================================================================
     3. LAYANAN SECTION
     ========================================================================== */
  .services-section {
    padding: 100px 0;
  }

  .section-header-block {
    margin-bottom: 44px;
  }

  .section-subtitle {
    font-size: 1.1rem;
    color: var(--color-text-muted);
    max-width: 580px;
    margin-top: 10px;
  }

  .services-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
  }

  .service-card {
    background: var(--color-bg-card);
    border-radius: 20px;
    padding: 30px 24px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 380px;
    border: 1px solid var(--color-border-soft);
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .service-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 16px 36px rgba(27, 56, 34, 0.1);
  }

  /* Hero highlighted card (Deep Clean) */
  .service-card.is-hero-card {
    background: var(--color-dark-green);
    color: #ffffff;
    border-color: transparent;
    transform: translateY(-4px);
    box-shadow: 0 16px 40px rgba(27, 56, 34, 0.16);
  }

  .service-card.is-hero-card .card-tag {
    background: var(--color-accent-lime);
    color: var(--color-dark-green);
    font-weight: 700;
  }

  .service-card.is-hero-card .card-name {
    color: #ffffff;
  }

  .service-card.is-hero-card .card-desc {
    color: #cfdec8;
  }

  .service-card.is-hero-card .card-footer {
    border-top-color: rgba(255, 255, 255, 0.15);
  }

  .service-card.is-hero-card .card-action-btn {
    background: #ffffff;
    color: var(--color-dark-green);
  }

  .card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 22px;
  }

  .card-tag {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 600;
    padding: 4px 10px;
    border-radius: 999px;
    background: rgba(27, 56, 34, 0.08);
    color: var(--color-dark-green);
  }

  .card-time {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    opacity: 0.6;
  }

  .card-alias {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    opacity: 0.7;
    display: block;
    margin-bottom: 6px;
  }

  .card-name {
    font-size: 1.45rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--color-dark-green);
    margin-bottom: 12px;
  }

  .card-desc {
    font-size: 0.88rem;
    line-height: 1.6;
    color: var(--color-text-muted);
  }

  .card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 26px;
    padding-top: 18px;
    border-top: 1px solid var(--color-border-soft);
  }

  .price-box {
    display: flex;
    flex-direction: column;
  }

  .price-label {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    text-transform: uppercase;
    opacity: 0.7;
  }

  .price-value {
    font-size: 1.35rem;
    font-weight: 800;
  }

  .card-action-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: var(--color-dark-green);
    color: #ffffff;
    font-size: 0.85rem;
    font-weight: 700;
    padding: 8px 16px;
    border-radius: 999px;
    transition: transform 0.15s ease;
  }

  .card-action-btn:hover {
    transform: scale(1.05);
  }

  /* ==========================================================================
     4. SHOWCASE BEFORE & AFTER SLIDER
     ========================================================================== */
  .showcase-section {
    padding: 95px 0;
    background: var(--color-bg-cream);
  }

  .showcase-card-container {
    max-width: 820px;
    margin-inline: auto;
    margin-top: 36px;
  }

  .showcase-floating-badges {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 14px;
    padding-inline: 8px;
  }

  .badge-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 14px;
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
  }

  .badge-before {
    background: rgba(27, 56, 34, 0.08);
    color: #7a5028;
    border: 1px solid rgba(122, 80, 40, 0.2);
  }

  .badge-after {
    background: var(--color-dark-green);
    color: #ffffff;
  }

  .badge-indicator {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #7a5028;
  }

  .badge-indicator.active {
    background: var(--color-accent-lime);
  }

  .comparison-container {
    position: relative;
    width: 100%;
    height: 380px;
    overflow: hidden;
    border-radius: 20px;
    box-shadow: 0 18px 45px rgba(27, 56, 34, 0.12);
    cursor: ew-resize;
    user-select: none;
    -webkit-user-select: none;
    background: #25402a;
    border: 2px solid rgba(27, 56, 34, 0.2);
  }

  .slider-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    pointer-events: none;
  }

  .slider-base-img {
    position: absolute;
    inset: 0;
  }

  .slider-overlay {
    position: absolute;
    top: 0;
    left: 0;
    bottom: 0;
    width: 50%;
    overflow: hidden;
    z-index: 2;
  }

  .slider-overlay-img {
    width: 820px; /* matched to card container width so it doesn't squish */
    max-width: none;
    filter: saturate(0.65) brightness(0.85);
  }

  .slider-handle {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    width: 4px;
    transform: translateX(-50%);
    cursor: ew-resize;
    z-index: 3;
    display: flex;
    align-items: center;
    justify-content: center;
    outline: none;
  }

  .handle-line {
    position: absolute;
    inset: 0;
    background: #ffffff;
    box-shadow: 0 0 8px rgba(0, 0, 0, 0.3);
  }

  .handle-thumb {
    position: relative;
    z-index: 4;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: #ffffff;
    color: var(--color-dark-green);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 3px;
    font-size: 0.72rem;
    font-weight: 800;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.3);
    border: 2px solid var(--color-dark-green);
    transition: transform 0.15s ease;
  }

  .slider-handle:hover .handle-thumb,
  .slider-handle:focus-visible .handle-thumb {
    transform: scale(1.1);
    box-shadow: 0 0 0 4px var(--color-accent-lime);
  }

  .thumb-bar {
    opacity: 0.4;
  }

  .slider-hint {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--color-text-muted);
    margin-top: 16px;
    text-align: center;
  }

  .hint-icon {
    font-weight: 700;
    color: var(--color-dark-green);
  }

  /* ==========================================================================
     5. PRICING SECTION & ADDONS
     ========================================================================== */
  .pricing-section {
    background-color: var(--color-forest-deep);
    padding: 100px 0;
    color: #ffffff;
  }

  .pricing-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    margin-bottom: 60px;
  }

  .pricing-card {
    background: #173822;
    border-radius: 24px;
    padding: 38px 30px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    border: 1px solid rgba(255, 255, 255, 0.08);
    position: relative;
    transition: transform 0.3s ease;
  }

  .pricing-card.is-highlight {
    background: #1e472c;
    border: 2px solid var(--color-accent-lime);
    box-shadow: 0 20px 45px rgba(0, 0, 0, 0.3);
    transform: translateY(-6px);
  }

  .pricing-badge {
    position: absolute;
    top: -14px;
    right: 28px;
    background: var(--color-accent-lime);
    color: var(--color-dark-green);
    font-family: var(--font-mono);
    font-size: 0.74rem;
    font-weight: 700;
    padding: 5px 14px;
    border-radius: 999px;
  }

  .package-name {
    font-size: 1.55rem;
    font-weight: 800;
    margin-bottom: 8px;
  }

  .package-desc {
    font-size: 0.88rem;
    color: #bfd4c2;
    margin-bottom: 22px;
    min-height: 44px;
  }

  .package-price {
    display: flex;
    align-items: baseline;
    gap: 6px;
    margin-bottom: 26px;
    padding-bottom: 22px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .package-price .currency {
    font-size: 1.1rem;
    font-weight: 600;
    color: #a7c5ae;
  }

  .package-price .amount {
    font-size: 2.7rem;
    font-weight: 800;
    line-height: 1;
  }

  .package-price .unit {
    font-size: 0.85rem;
    color: #a7c5ae;
  }

  .package-features {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin-bottom: 34px;
  }

  .package-features li {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 0.9rem;
    color: #e5ece6;
  }

  .feat-check {
    color: var(--color-accent-lime);
    font-weight: 800;
  }

  .btn-order {
    display: block;
    text-align: center;
    background: rgba(255, 255, 255, 0.1);
    color: #ffffff;
    padding: 14px;
    border-radius: 999px;
    font-weight: 700;
    transition: all 0.2s ease;
  }

  .btn-order:hover {
    background: rgba(255, 255, 255, 0.2);
    transform: translateY(-2px);
  }

  .btn-order-highlight {
    background: var(--color-accent-lime);
    color: var(--color-dark-green);
  }

  .btn-order-highlight:hover {
    background: #c3e843;
    color: var(--color-dark-green);
  }

  /* ADDONS */
  .addons-container {
    background: rgba(255, 255, 255, 0.04);
    border-radius: 24px;
    padding: 36px;
    border: 1px solid rgba(255, 255, 255, 0.08);
  }

  .addons-heading {
    font-size: 1.25rem;
    font-weight: 800;
    margin-bottom: 22px;
  }

  .addons-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }

  .addon-card {
    background: #193a23;
    border-radius: 16px;
    padding: 18px;
    display: flex;
    align-items: center;
    gap: 14px;
    border: 1px solid rgba(255, 255, 255, 0.06);
  }

  .addon-icon-box {
    width: 36px;
    height: 36px;
    border-radius: 10px;
    background: rgba(176, 212, 58, 0.15);
    color: var(--color-accent-lime);
    display: grid;
    place-items: center;
    font-weight: 800;
    font-size: 1.1rem;
    flex-shrink: 0;
  }

  .addon-info {
    flex: 1;
  }

  .addon-title {
    font-size: 0.88rem;
    font-weight: 800;
    margin-bottom: 2px;
  }

  .addon-desc {
    font-size: 0.72rem;
    color: #a7bfae;
    line-height: 1.4;
  }

  .addon-price {
    font-family: var(--font-mono);
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--color-accent-lime);
    flex-shrink: 0;
  }

  .addon-action {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.1);
    color: #ffffff;
    font-weight: 800;
    flex-shrink: 0;
    transition: all 0.2s ease;
  }

  .addon-action:hover {
    background: var(--color-accent-lime);
    color: var(--color-dark-green);
  }

  /* ==========================================================================
     6. KENAPA MEMILIH KAMI (Values Grid)
     ========================================================================== */
  .why-us-section {
    padding: 100px 0;
  }

  .values-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 22px;
  }

  .value-card {
    background: var(--color-bg-card);
    border-radius: 20px;
    padding: 34px 26px;
    border: 1px solid var(--color-border-soft);
    display: flex;
    flex-direction: column;
    gap: 14px;
    transition: transform 0.2s ease;
  }

  .value-card:hover {
    transform: translateY(-5px);
  }

  .value-icon-box {
    width: 48px;
    height: 48px;
    border-radius: 14px;
    background: rgba(27, 56, 34, 0.08);
    color: var(--color-dark-green);
    display: grid;
    place-items: center;
  }

  .value-title {
    font-size: 1.2rem;
    font-weight: 800;
    color: var(--color-dark-green);
  }

  .value-desc {
    font-size: 0.9rem;
    line-height: 1.65;
    color: var(--color-text-muted);
  }

  /* ==========================================================================
     7. TESTIMONI
     ========================================================================== */
  .testimonials-section {
    padding: 95px 0;
    background: var(--color-bg-cream);
  }

  .testi-header {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-bottom: 46px;
  }

  .testi-pill-badge {
    background: var(--color-dark-green);
    color: #ffffff;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 600;
    padding: 6px 16px;
    border-radius: 999px;
  }

  .testimonials-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .testi-card {
    background: #ffffff;
    border-radius: 24px;
    padding: 38px 30px;
    box-shadow: 0 12px 30px rgba(27, 56, 34, 0.06);
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    border: 1px solid var(--color-border-soft);
  }

  .testi-quote-mark {
    font-family: var(--font-serif);
    font-size: 3.8rem;
    line-height: 1;
    color: rgba(27, 56, 34, 0.12);
    position: absolute;
    top: 20px;
    right: 28px;
  }

  .testi-stars {
    color: #e59819;
    letter-spacing: 3px;
    font-size: 0.95rem;
    margin-bottom: 18px;
  }

  .testi-text {
    font-size: 0.95rem;
    line-height: 1.7;
    color: var(--color-text-muted);
    margin-bottom: 26px;
    font-style: italic;
  }

  .testi-author {
    display: flex;
    align-items: center;
    gap: 14px;
    padding-top: 18px;
    border-top: 1px solid var(--color-border-soft);
  }

  .author-avatar {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid var(--color-dark-green);
  }

  .author-meta {
    display: flex;
    flex-direction: column;
  }

  .author-name {
    font-size: 0.95rem;
    color: var(--color-dark-green);
  }

  .author-role {
    font-size: 0.78rem;
    color: var(--color-text-muted);
  }

  /* ==========================================================================
     8. CTA SECTION
     ========================================================================== */
  .cta-section {
    padding: 95px 0 110px;
  }

  .cta-banner {
    background: var(--color-bg-card);
    border-radius: 28px;
    padding: 65px 55px;
    border: 2px solid rgba(27, 56, 34, 0.15);
    box-shadow: 0 20px 50px rgba(27, 56, 34, 0.08);
    position: relative;
    overflow: hidden;
  }

  .cta-title {
    font-size: clamp(2.4rem, 4.6vw, 4.2rem);
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: var(--color-dark-green);
    margin-bottom: 16px;
  }

  .cta-desc {
    font-size: 1.12rem;
    color: var(--color-text-muted);
    max-width: 560px;
    margin-bottom: 32px;
  }

  .cta-buttons {
    display: flex;
    align-items: center;
    gap: 18px;
    flex-wrap: wrap;
  }

  /* ==========================================================================
     9. FOOTER
     ========================================================================== */
  .site-footer {
    background: var(--color-forest-deep);
    color: #ffffff;
    padding: 70px 0 40px;
  }

  .footer-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 28px;
  }

  .footer-svg-logo {
    height: 55px;
    width: auto;
  }

  .footer-divider {
    width: 100%;
    max-width: 800px;
    height: 1px;
    background: rgba(255, 255, 255, 0.12);
  }

  .footer-nav {
    display: flex;
    align-items: center;
    gap: 32px;
    flex-wrap: wrap;
    justify-content: center;
  }

  .footer-nav a {
    font-size: 0.9rem;
    font-weight: 600;
    color: #d1dcce;
    transition: color 0.15s ease;
  }

  .footer-nav a:hover {
    color: var(--color-accent-lime);
  }

  .footer-socials {
    display: flex;
    align-items: center;
    gap: 18px;
  }

  .social-icon {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.08);
    display: grid;
    place-items: center;
    color: #ffffff;
    transition: all 0.2s ease;
  }

  .social-icon:hover {
    background: var(--color-accent-lime);
    color: var(--color-dark-green);
    transform: translateY(-3px);
  }

  .footer-meta {
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: #8fa092;
  }

  /* ==========================================================================
     RESPONSIVE BREAKPOINTS (Mobile First / Tablet / Desktop)
     ========================================================================== */
  @media (max-width: 1024px) {
    .services-grid,
    .values-grid,
    .addons-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .hero-shell {
      grid-template-columns: 1fr;
      text-align: center;
      gap: 40px;
    }

    .hero-content {
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    .hero-desc {
      margin-inline: auto;
    }

    .hero-actions {
      justify-content: center;
    }

    .hero-trust {
      justify-content: center;
    }

    .about-top-grid {
      grid-template-columns: 1fr;
      text-align: center;
    }

    .about-brand-visual {
      max-width: 340px;
      margin-inline: auto;
    }

    .about-stats-row {
      justify-content: center;
    }

    .pillars-card {
      grid-template-columns: 1fr;
      gap: 30px;
      padding: 34px 24px;
    }

    .pillar-divider {
      border-inline: none;
      border-block: 1px solid rgba(27, 56, 34, 0.1);
      padding-inline: 0;
      padding-block: 30px;
    }

    .pricing-grid {
      grid-template-columns: 1fr;
    }

    .pricing-card.is-highlight {
      transform: none;
    }

    .testimonials-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 768px) {
    .nav-pill {
      display: none;
    }

    .mobile-menu-toggle {
      display: flex;
    }

    .hero-section {
      padding-top: 95px;
      padding-bottom: 40px;
    }

    .hero-title {
      font-size: 2.8rem;
    }

    .hero-actions {
      flex-direction: column;
      width: 100%;
    }

    .hero-actions .btn {
      width: 100%;
    }

    .hero-trust {
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: 6px;
    }

    .services-grid,
    .values-grid,
    .addons-grid {
      grid-template-columns: 1fr;
    }

    .comparison-container {
      height: 260px;
    }

    .slider-overlay-img {
      width: 100vw;
    }

    .cta-banner {
      padding: 40px 22px;
    }

