---
import { whatsappGeneral } from '../data/site';
---

<!-- 9. FOOTER -->
    <footer class="site-footer">
      <div class="section-shell footer-content">
        <!-- Logo Emblem -->
        <div class="footer-brand">
          <img src="/images/logo-white.png" alt="Sparklin Shoe Care" class="footer-svg-logo" />
        </div>

        <div class="footer-divider"></div>

        <!-- Navigation Links -->
        <nav class="footer-nav" aria-label="Menu navigasi footer">
          <a href="#beranda">Beranda</a>
          <a href="#tentang">Tentang</a>
          <a href="#layanan">Layanan</a>
          <a href="#harga">Harga</a>
          <a href="#testimoni">Testimoni</a>
          <a href={whatsappGeneral} target="_blank" rel="noreferrer">Kontak</a>
        </nav>

        <!-- Social Icons -->
        <div class="footer-socials">
          <a href="https://instagram.com/sparklinshoecare" target="_blank" rel="noreferrer" class="social-icon" aria-label="Instagram Sparklin Shoe Care">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/></svg>
          </a>
          <a href={whatsappGeneral} target="_blank" rel="noreferrer" class="social-icon" aria-label="WhatsApp Sparklin Shoe Care">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          </a>
          <a href="https://tiktok.com/@sparklinshoecare" target="_blank" rel="noreferrer" class="social-icon" aria-label="TikTok Sparklin Shoe Care">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 12a4 4 0 1 0 4 4V4a5 5 0 0 0 5 5"/></svg>
          </a>
        </div>
        
        <p class="footer-location" style="font-family: var(--font-mono); font-size: 0.85rem; color: #8fa092; margin-top: -5px;">Bandung, Jawa Barat</p>
      </div>

      <div class="footer-bottom-bar">
        <div class="section-shell bottom-bar-inner">
          <p>© 2026 Sparklin Shoe Care</p>
          <p>Dibuat oleh: @weareanoa</p>
        </div>
      </div>
    </footer>

<style is:global>
.site-footer {
    background: rgb(11, 61, 30);
    color: #ffffff;
    padding: 70px 0 20px;
}

.footer-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 28px;
}

.footer-svg-logo {
    height: 75px;
    width: auto;
}

.footer-divider {
    width: 15%;
    max-width: 800px;
    height: 1px;
    background: rgba(255, 255, 255, 0.12);
    margin-top: -16px;
}

.footer-nav {
    display: flex;
    align-items: center;
    gap: 32px;
    flex-wrap: wrap;
    justify-content: center;
}

.footer-nav a {
    font-size: 0.9rem;
    font-weight: 600;
    color: #d1dcce;
    transition: color 0.15s ease;
}

.footer-nav a:hover {
    color: var(--color-accent-lime);
}

.footer-socials {
    display: flex;
    align-items: center;
    gap: 18px;
}

.social-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: #ffffff;
    transition: all 0.2s ease;
}

.social-icon:hover {
    color: var(--color-accent-lime);
    transform: translateY(-3px);
}

.footer-bottom-bar {
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    margin-top: 24px;
    padding-top: 16px;
    width: 100%;
}

.bottom-bar-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: #8fa092;
    flex-wrap: wrap;
    gap: 16px;
}

@media (max-width: 768px) {
  .footer-nav {
      gap: 16px;
  }
  .bottom-bar-inner {
      justify-content: center;
      text-align: center;
  }
}
</style>
