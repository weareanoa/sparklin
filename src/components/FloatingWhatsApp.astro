---
import { whatsappGeneral } from '../data/site';
---

<!-- Floating WhatsApp Button -->
    <a href={whatsappGeneral} target="_blank" rel="noreferrer" class="floating-wa-btn" aria-label="Chat via WhatsApp">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12.04 2a9.9 9.9 0 0 0-8.57 14.85L2 22l5.3-1.42A9.9 9.9 0 1 0 12.04 2Zm5.8 14.12c-.25.7-1.45 1.33-2 1.38-.5.05-1.13.24-3.8-.79-3.22-1.27-5.26-4.55-5.42-4.76-.16-.21-1.3-1.72-1.3-3.28 0-1.56.82-2.33 1.11-2.65.29-.32.63-.4.84-.4h.6c.2 0 .46-.07.71.54.26.63.88 2.18.96 2.34.08.16.13.34.02.55-.1.21-.16.34-.31.52l-.47.55c-.16.16-.32.33-.14.65.19.32.83 1.37 1.79 2.22 1.23 1.1 2.27 1.44 2.59 1.6.32.16.5.13.69-.08.19-.21.79-.92 1-1.24.21-.32.42-.26.71-.16.29.11 1.83.87 2.15 1.03.32.16.53.23.6.37.08.13.08.77-.17 1.51Z"/></svg>
      <span>WhatsApp</span>
    </a>

<style is:global>
.floating-wa-btn {
position: fixed;
    bottom: 24px;
    right: 24px;
    z-index: 90;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: #cfe0bf;
    color: var(--color-dark-green);
    font-size: 1.1rem;
    font-weight: 700;
    padding: 16px 30px;
    border-radius: 999px;
    box-shadow: 0 14px 32px rgba(0, 0, 0, 0.25);
    transition: transform 0.2s ease, background 0.2s ease;
}

.floating-wa-btn:hover {
background: #ddebd0;
    transform: translateY(-3px);
}
</style>
