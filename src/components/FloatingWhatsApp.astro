---
import { whatsappGeneral } from '../data/site';
---

<a href={whatsappGeneral} target="_blank" rel="noreferrer" class="floating-wa-btn" aria-label="Chat via WhatsApp">
  <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="floating-wa-icon"><path d="M12.04 2a9.9 9.9 0 0 0-8.57 14.85L2 22l5.3-1.42A9.9 9.9 0 1 0 12.04 2Zm5.8 14.12c-.25.7-1.45 1.33-2 1.38-.5.05-1.13.24-3.8-.79-3.22-1.27-5.26-4.55-5.42-4.76-.16-.21-1.3-1.72-1.3-3.28 0-1.56.82-2.33 1.11-2.65.29-.32.63-.4.84-.4h.6c.2 0 .46-.07.71.54.26.63.88 2.18.96 2.34.08.16.13.34.02.55-.1.21-.16.34-.31.52l-.47.55c-.16.16-.32.33-.14.65.19.32.83 1.37 1.79 2.22 1.23 1.1 2.27 1.44 2.59 1.6.32.16.53.23.6.37.08.13.08.77-.17 1.51Z"/></svg>
  <span class="floating-wa-label">WhatsApp</span>
</a>

<style is:global>
.floating-wa-btn {
  position: fixed;
  bottom: 24px;
  right: 24px;
  z-index: 90;
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: var(--color-cream);
  color: var(--color-secondary);
  font-size: 0.98rem;
  font-weight: 700;
  padding: 12px 22px;
  border-radius: 999px;
  box-shadow: 0 10px 26px rgba(11, 61, 30, 0.22);
  transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1), background 0.2s ease, box-shadow 0.2s ease;
  border: 1.5px solid rgba(11, 61, 30, 0.15);
  text-decoration: none;
}

.floating-wa-btn:hover {
  background: #f7f7c8;
  transform: translateY(-3px);
  box-shadow: 0 14px 32px rgba(11, 61, 30, 0.28);
}

.floating-wa-btn:active {
  transform: scale(0.96);
}

.floating-wa-icon {
  width: 20px;
  height: 20px;
  flex-shrink: 0;
}

@media (max-width: 768px) {
  .floating-wa-btn {
    bottom: 18px;
    right: 18px;
    padding: 10px 16px;
    font-size: 0.88rem;
    gap: 6px;
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.2);
  }

  .floating-wa-icon {
    width: 18px;
    height: 18px;
  }
}

@media (max-width: 480px) {
  .floating-wa-btn {
    bottom: 14px;
    right: 14px;
    padding: 8px 14px;
    font-size: 0.82rem;
    gap: 5px;
    box-shadow: 0 5px 14px rgba(0, 0, 0, 0.18);
  }

  .floating-wa-icon {
    width: 17px;
    height: 17px;
  }
}
</style>
