---
import { pricingPackages, addOns, whatsappBase } from '../../data/site';
---

<section class="pricing-section" id="harga">
  <div class="section-shell">
    <div class="pricing-wrapper-card">
      <div class="pricing-header-inside">
        <h2 class="pricing-title">
          <span class="italic-title">Daftar</span> <strong>Harga</strong>
        </h2>
      </div>

      <div class="pricing-packages-grid">
        {pricingPackages.map((pkg) => {
          const waUrl = `${whatsappBase}${encodeURIComponent(pkg.waMessage)}`;
          return (
            <div class={`pkg-card ${pkg.highlight ? 'is-highlight' : ''}`}>
              <div class="pkg-top">
                <h3 class="pkg-name">{pkg.name}</h3>
                <p class="pkg-desc">{pkg.desc}</p>
              </div>

              <div class="pkg-price-row">
                <span class="pkg-amount">{pkg.price.replace('.000', '')}</span>
                <span class="pkg-unit">ribu {pkg.unit}</span>
              </div>

              <a
                href={waUrl}
                target="_blank"
                rel="noreferrer"
                class={`pkg-btn ${pkg.highlight ? 'pkg-btn-highlight' : ''}`}
                aria-label={`Pesan paket ${pkg.name}`}
              >
                Pesan Sekarang
              </a>
            </div>
          );
        })}
      </div>

      <div class="pricing-addons-grid">
        {addOns.map((add) => {
          const waUrl = `${whatsappBase}${encodeURIComponent(`Halo Sparklin, saya ingin tambah addon ${add.title} (${add.price}).`)}`;
          return (
            <div class="addon-pill-card">
              <div class="addon-left">
                <div class="addon-icon">+</div>
                <div class="addon-details">
                  <h4 class="addon-title">{add.title}</h4>
                  <p class="addon-desc">{add.desc}</p>
                </div>
              </div>
              <div class="addon-right">
                <span class="addon-price">{add.price}</span>
                <a href={waUrl} target="_blank" rel="noreferrer" class="addon-btn-link" aria-label={`Pesan addon ${add.title}`}>
                  +
                </a>
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </div>
</section>

<style is:global>
.pricing-section {
  padding: 90px 0;
  background-color: var(--color-cream);
  position: relative;
}

.pricing-wrapper-card {
  background: var(--color-secondary);
  border-radius: 36px;
  padding: 55px 48px;
  box-shadow: 0 20px 50px rgba(11, 61, 30, 0.18);
  display: flex;
  flex-direction: column;
  gap: 32px;
}

.pricing-header-inside {
  margin-bottom: 4px;
}

.pricing-title {
  font-size: clamp(2.4rem, 5vw, 3.8rem);
  color: var(--color-cream);
  line-height: 1.1;
  letter-spacing: -0.02em;
}

.pricing-title .italic-title {
  font-family: var(--font-serif);
  font-style: italic;
  font-weight: 500;
  margin-right: 6px;
}

.pricing-title strong {
  font-family: var(--font-sans);
  font-weight: 800;
}

.pricing-packages-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20px;
  align-items: stretch;
}

.pkg-card {
  background: var(--color-cream);
  border-radius: 28px;
  padding: 34px 26px 28px;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  position: relative;
  transition: transform 0.25s ease, box-shadow 0.25s ease;
  min-height: 290px;
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
}

.pkg-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 16px 36px rgba(11, 61, 30, 0.2);
}

.pkg-card.is-highlight {
  background: #2f6b45;
  color: var(--color-cream);
  border: 2px solid rgba(254, 254, 227, 0.35);
}

.pkg-name {
  font-size: 1.15rem;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 0.04em;
  color: var(--color-secondary);
  margin-bottom: 10px;
}

.pkg-card.is-highlight .pkg-name {
  color: var(--color-cream);
}

.pkg-desc {
  font-size: 0.85rem;
  color: var(--color-text-muted);
  line-height: 1.5;
  min-height: 44px;
}

.pkg-card.is-highlight .pkg-desc {
  color: rgba(254, 254, 227, 0.85);
}

.pkg-price-row {
  display: flex;
  align-items: baseline;
  gap: 6px;
  margin: 18px 0 22px;
}

.pkg-amount {
  font-size: 2.6rem;
  font-weight: 800;
  line-height: 1;
  color: var(--color-secondary);
  font-family: var(--font-sans);
}

.pkg-card.is-highlight .pkg-amount {
  color: var(--color-cream);
}

.pkg-unit {
  font-size: 0.82rem;
  color: var(--color-text-muted);
  font-weight: 600;
}

.pkg-card.is-highlight .pkg-unit {
  color: rgba(254, 254, 227, 0.85);
}

.pkg-btn {
  display: block;
  text-align: center;
  background: var(--color-secondary);
  color: var(--color-cream);
  padding: 13px 20px;
  border-radius: 999px;
  font-weight: 700;
  font-size: 0.92rem;
  text-decoration: none;
  transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  box-shadow: 0 4px 12px rgba(66, 139, 94, 0.18);
}

.pkg-btn:hover {
  background: #35724d;
  transform: translateY(-2px);
  box-shadow: 0 6px 18px rgba(66, 139, 94, 0.28);
}

.pkg-btn-highlight {
  background: var(--color-cream);
  color: var(--color-secondary);
  border: none;
  font-weight: 800;
  box-shadow: 0 4px 14px rgba(0, 0, 0, 0.15);
}

.pkg-btn-highlight:hover {
  background: #f7f7c8;
  color: var(--color-secondary);
  transform: translateY(-2px);
}

.pricing-addons-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16px;
}

.addon-pill-card {
  background: var(--color-cream);
  border-radius: 999px;
  padding: 14px 24px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  transition: transform 0.2s ease, box-shadow 0.2s ease;
  box-shadow: 0 6px 20px rgba(0, 0, 0, 0.08);
}

.addon-pill-card:hover {
  transform: translateY(-2px);
  box-shadow: 0 10px 26px rgba(11, 61, 30, 0.18);
}

.addon-left {
  display: flex;
  align-items: center;
  gap: 14px;
  min-width: 0;
  flex: 1;
}

.addon-icon {
  width: 34px;
  height: 34px;
  border-radius: 10px;
  background: var(--color-secondary);
  color: var(--color-cream);
  display: grid;
  place-items: center;
  font-weight: 800;
  font-size: 1.15rem;
  flex-shrink: 0;
}

.addon-details {
  min-width: 0;
  flex: 1;
}

.addon-title {
  font-size: 0.88rem;
  font-weight: 800;
  color: var(--color-secondary);
  margin-bottom: 2px;
  text-transform: uppercase;
  letter-spacing: 0.02em;
}

.addon-desc {
  font-size: 0.74rem;
  color: var(--color-text-muted);
  line-height: 1.35;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.addon-right {
  display: flex;
  align-items: center;
  gap: 12px;
  flex-shrink: 0;
}

.addon-price {
  font-family: var(--font-sans);
  font-size: 1.2rem;
  font-weight: 800;
  color: var(--color-secondary);
}

.addon-btn-link {
  display: grid;
  place-items: center;
  width: 30px;
  height: 30px;
  border-radius: 50%;
  background: var(--color-secondary);
  color: var(--color-cream);
  font-weight: 800;
  font-size: 1rem;
  text-decoration: none;
  transition: transform 0.2s ease, background 0.2s ease;
}

.addon-btn-link:hover {
  background: #35724d;
  transform: scale(1.1);
}

@media (max-width: 1024px) {
  .pricing-section {
    padding: 70px 0;
  }

  .pricing-wrapper-card {
    padding: 40px 28px;
    border-radius: 28px;
  }

  .pricing-packages-grid {
    grid-template-columns: 1fr;
    gap: 18px;
  }

  .pricing-addons-grid {
    grid-template-columns: 1fr;
    gap: 12px;
  }
}

@media (max-width: 640px) {
  .pricing-section {
    padding: 50px 0 60px;
  }

  .pricing-wrapper-card {
    padding: 28px 16px;
    border-radius: 22px;
    gap: 22px;
  }

  .pricing-title {
    font-size: clamp(2rem, 6.5vw, 2.6rem);
  }

  .pkg-card {
    padding: 24px 18px;
    border-radius: 20px;
    min-height: auto;
  }

  .pkg-amount {
    font-size: 2.2rem;
  }

  .addon-pill-card {
    border-radius: 20px;
    padding: 12px 14px;
  }

  .addon-desc {
    white-space: normal;
  }
}

@media (max-width: 420px) {
  .addon-pill-card {
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
  }

  .addon-right {
    width: 100%;
    justify-content: space-between;
  }
}
</style>
