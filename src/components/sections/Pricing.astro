---
import { pricingPackages, addOns, whatsappBase } from '../../data/site';
---

<section class="pricing-section" id="harga">
        <div class="section-shell">
          <div class="section-header-block">
            <h2 class="section-title text-white">
              <span class="italic-serif">Daftar</span> Harga
            </h2>
            <p class="section-subtitle text-white-muted">
              Tarif terjangkau dan transparan untuk mahasiswa dan pecinta sneakers di Bandung.
            </p>
          </div>

          <!-- Pricing Packages Grid -->
          <div class="pricing-grid">
            {pricingPackages.map((pkg) => {
              const waUrl = `${whatsappBase}${encodeURIComponent(pkg.waMessage)}`;
              return (
                <div class={`pricing-card ${pkg.highlight ? 'is-highlight' : ''}`}>
                  {pkg.badge && <div class="pricing-badge">{pkg.badge}</div>}

                  <div class="pricing-header">
                    <h3 class="package-name">{pkg.name}</h3>
                    <p class="package-desc">{pkg.desc}</p>
                    <div class="package-price">
                      <span class="currency">Rp</span>
                      <span class="amount">{pkg.price}</span>
                      <span class="unit">{pkg.unit}</span>
                    </div>
                  </div>

                  <ul class="package-features">
                    {pkg.features.map((feat) => (
                      <li>
                        <span class="feat-check">✓</span>
                        <span>{feat}</span>
                      </li>
                    ))}
                  </ul>

                  <a href={waUrl} target="_blank" rel="noreferrer" class={`btn-order ${pkg.highlight ? 'btn-order-highlight' : ''}`}>
                    Pesan Sekarang ↗
                  </a>
                </div>
              );
            })}
          </div>

          <!-- Addons Grid -->
          <div class="addons-container">
            <h3 class="addons-heading">Layanan Tambahan (Add-on)</h3>
            <div class="addons-grid">
              {addOns.map((add) => {
                const waUrl = `${whatsappBase}${encodeURIComponent(`Halo Sparklin, saya ingin tambah addon ${add.title} (${add.price}).`)}`;
                return (
                  <div class="addon-card">
                    <div class="addon-icon-box">+</div>
                    <div class="addon-info">
                      <h4 class="addon-title">{add.title}</h4>
                      <p class="addon-desc">{add.desc}</p>
                    </div>
                    <div class="addon-price">{add.price}</div>
                    <a href={waUrl} target="_blank" rel="noreferrer" class="addon-action" aria-label={`Pesan addon ${add.title}`}>+</a>
                  </div>
                );
              })}
            </div>
          </div>
        </div>
      </section>

<style is:global>
.pricing-section {
background-color: var(--color-forest-deep);
    padding: 100px 0;
    color: #ffffff;
}

.pricing-grid {
display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    margin-bottom: 60px;
}

.pricing-card {
background: #173822;
    border-radius: 24px;
    padding: 38px 30px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    border: 1px solid rgba(255, 255, 255, 0.08);
    position: relative;
    transition: transform 0.3s ease;
}

.pricing-card.is-highlight {
background: #1e472c;
    border: 2px solid var(--color-accent-lime);
    box-shadow: 0 20px 45px rgba(0, 0, 0, 0.3);
    transform: translateY(-6px);
}

.pricing-badge {
position: absolute;
    top: -14px;
    right: 28px;
    background: var(--color-accent-lime);
    color: var(--color-dark-green);
    font-family: var(--font-mono);
    font-size: 0.74rem;
    font-weight: 700;
    padding: 5px 14px;
    border-radius: 999px;
}

.package-name {
font-size: 1.55rem;
    font-weight: 800;
    margin-bottom: 8px;
}

.package-desc {
font-size: 0.88rem;
    color: #bfd4c2;
    margin-bottom: 22px;
    min-height: 44px;
}

.package-price {
display: flex;
    align-items: baseline;
    gap: 6px;
    margin-bottom: 26px;
    padding-bottom: 22px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
}

.package-price .currency {
font-size: 1.1rem;
    font-weight: 600;
    color: #a7c5ae;
}

.package-price .amount {
font-size: 2.7rem;
    font-weight: 800;
    line-height: 1;
}

.package-price .unit {
font-size: 0.85rem;
    color: #a7c5ae;
}

.package-features {
list-style: none;
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin-bottom: 34px;
}

.package-features li {
display: flex;
    align-items: center;
    gap: 10px;
    font-size: 0.9rem;
    color: #e5ece6;
}

.feat-check {
color: var(--color-accent-lime);
    font-weight: 800;
}

.btn-order {
display: block;
    text-align: center;
    background: rgba(255, 255, 255, 0.1);
    color: #ffffff;
    padding: 14px;
    border-radius: 999px;
    font-weight: 700;
    transition: all 0.2s ease;
}

.btn-order:hover {
background: rgba(255, 255, 255, 0.2);
    transform: translateY(-2px);
}

.btn-order-highlight {
background: var(--color-accent-lime);
    color: var(--color-dark-green);
}

.btn-order-highlight:hover {
background: #c3e843;
    color: var(--color-dark-green);
}

.addons-container {
background: rgba(255, 255, 255, 0.04);
    border-radius: 24px;
    padding: 36px;
    border: 1px solid rgba(255, 255, 255, 0.08);
}

.addons-heading {
font-size: 1.25rem;
    font-weight: 800;
    margin-bottom: 22px;
}

.addons-grid {
display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
}

.addon-card {
background: #193a23;
    border-radius: 16px;
    padding: 18px;
    display: flex;
    align-items: center;
    gap: 14px;
    border: 1px solid rgba(255, 255, 255, 0.06);
}

.addon-icon-box {
width: 36px;
    height: 36px;
    border-radius: 10px;
    background: rgba(176, 212, 58, 0.15);
    color: var(--color-accent-lime);
    display: grid;
    place-items: center;
    font-weight: 800;
    font-size: 1.1rem;
    flex-shrink: 0;
}

.addon-info {
flex: 1;
}

.addon-title {
font-size: 0.88rem;
    font-weight: 800;
    margin-bottom: 2px;
}

.addon-desc {
font-size: 0.72rem;
    color: #a7bfae;
    line-height: 1.4;
}

.addon-price {
font-family: var(--font-mono);
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--color-accent-lime);
    flex-shrink: 0;
}

.addon-action {
display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.1);
    color: #ffffff;
    font-weight: 800;
    flex-shrink: 0;
    transition: all 0.2s ease;
}

.addon-action:hover {
background: var(--color-accent-lime);
    color: var(--color-dark-green);
}

@media (max-width: 1024px) {
  .pricing-grid {

      grid-template-columns: 1fr;
    
  }

  .pricing-card.is-highlight {

      transform: none;
    
  }
}
</style>
