---
import { whatsappGeneral, withBase } from '../../data/site';
---

<section class="hero-section" id="beranda">
  <div class="hero-shell">
    <h1 class="hero-title">
      Step up,<br />
      <span class="italic-title">Stand</span> out.
    </h1>

    <div class="hero-visual-band">
      <div class="hero-sparklin-banner" aria-hidden="true">
        <span class="hero-sparklin-text">SPARKLIN</span>
      </div>

      <div class="hero-sneaker-container">
        <div class="sneaker-wrap">
          <img
            src={withBase("/images/hero-sneakers-pair.png")}
            alt="Air Jordan 4 sneaker sebelum dan sesudah perawatan di Sparklin Shoe Care"
            class="hero-sneaker-img"
            draggable="false"
          />
        </div>
      </div>
    </div>

    <div class="hero-bottom-content">
      <p class="hero-desc">
        Perawatan sepatu di Bandung sejak 2024. Cuci, hilangkan noda, dan perbaikan dengan pendekatan ramah lingkungan untuk mahasiswa dan penggemar sneakers.
      </p>

      <div class="hero-actions">
        <a href={whatsappGeneral} target="_blank" rel="noreferrer" class="btn btn-primary">
          <span>Booking via WhatsApp</span>
          <span class="btn-arrow">↗</span>
        </a>
        <a href="#layanan" class="btn btn-secondary">
          <span>Lihat Layanan</span>
          <span class="btn-arrow">↓</span>
        </a>
      </div>
    </div>
  </div>
</section>

<style is:global>
@font-face {
  font-family: 'Montserrat';
  font-style: normal;
  font-weight: 900;
  font-display: block;
  src: local('Montserrat Black'), local('Montserrat-Black'),
       url('https://fonts.gstatic.com/s/montserrat/v29/JTUSjIg1_i6t8kCHKm459WRhyzbi.woff2') format('woff2');
  unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
}

.hero-section {
  position: relative;
  padding-top: 130px;
  padding-bottom: 75px;
  min-height: 85vh;
  display: flex;
  align-items: center;
  background-color: var(--color-cream);
  overflow: hidden;
}

.hero-shell {
  position: relative;
  z-index: 2;
  width: min(1200px, calc(100% - 48px));
  margin-inline: auto;
  display: flex;
  flex-direction: column;
}

.hero-title {
  font-family: var(--font-sans);
  font-size: clamp(2.6rem, 4.4vw, 4.2rem);
  line-height: 1.05;
  letter-spacing: -0.03em;
  font-weight: 800;
  color: var(--color-secondary);
  margin-bottom: 4px;
}

.italic-title {
  font-style: italic;
  font-weight: 400;
}

.hero-visual-band {
  position: relative;
  width: 100%;
  height: clamp(90px, 14vw, 190px);
  min-height: 90px;
  display: flex;
  align-items: center;
  margin: 6px 0 20px 0;
  overflow: visible;
}

.hero-sparklin-banner {
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 100%;
  user-select: none;
  pointer-events: none;
  z-index: 1;
}

.hero-sparklin-text {
  display: block;
  font-family: 'Montserrat', 'Arial Black', Impact, sans-serif;
  font-weight: 900;
  font-size: clamp(4.5rem, 13.5vw, 13.5rem);
  color: rgba(66, 139, 94, 0.22);
  letter-spacing: -0.01em;
  line-height: 0.82;
  text-transform: uppercase;
  white-space: nowrap;
  -webkit-font-smoothing: antialiased;
  text-rendering: optimizeLegibility;
  visibility: inherit;
}

.hero-sneaker-container {
  position: absolute;
  right: 0;
  top: 50%;
  transform: translateY(-50%);
  width: clamp(220px, 46vw, 640px);
  z-index: 5;
  display: flex;
  justify-content: flex-end;
  pointer-events: auto;
}

.sneaker-wrap {
  position: relative;
  width: 100%;
  transform: scale(1.16) translate(20px, -5px);
  transform-origin: center right;
  transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
}

.sneaker-wrap:hover {
  transform: scale(1.2) translate(20px, -10px);
}

.hero-sneaker-img {
  width: 100%;
  height: auto;
  object-fit: contain;
  filter: drop-shadow(0 25px 40px rgba(11, 61, 30, 0.28));
}

.hero-bottom-content {
  position: relative;
  z-index: 2;
  display: flex;
  flex-direction: column;
}

.hero-desc {
  font-size: 1.05rem;
  line-height: 1.6;
  color: var(--color-text-muted);
  max-width: 500px;
  margin-bottom: 24px;
  font-weight: 500;
}

.hero-actions {
  display: flex;
  align-items: center;
  gap: 16px;
  flex-wrap: wrap;
}

@media (max-width: 1024px) {
  .hero-section {
    padding-top: 110px;
    padding-bottom: 55px;
    min-height: auto;
  }

  .hero-visual-band {
    height: clamp(80px, 16vw, 140px);
    min-height: 80px;
    margin: 4px 0 18px 0;
  }

  .hero-sneaker-container {
    width: clamp(200px, 48vw, 440px);
    right: -10px;
  }

  .sneaker-wrap {
    transform: scale(1.1) translate(10px, 0);
  }
}

@media (max-width: 600px) {
  .hero-section {
    padding-top: 95px;
    padding-bottom: 40px;
  }

  .hero-title {
    font-size: clamp(2.2rem, 7.5vw, 2.7rem);
  }

  .hero-visual-band {
    height: clamp(65px, 18vw, 95px);
    min-height: 65px;
    margin: 2px 0 14px 0;
  }

  .hero-sparklin-text {
    font-size: clamp(3rem, 13vw, 4.5rem);
  }

  .hero-sneaker-container {
    width: clamp(165px, 48vw, 250px);
    right: -12px;
  }

  .sneaker-wrap {
    transform: scale(1.06);
  }

  .hero-desc {
    font-size: 0.92rem;
    line-height: 1.5;
    max-width: 100%;
    margin-bottom: 20px;
  }

  .hero-actions {
    flex-direction: column;
    width: 100%;
  }

  .hero-actions .btn {
    width: 100%;
  }
}
</style>
