<section class="why-us-section" id="kenapa">
  <div class="wu-container">
    <div class="wu-card">
      <div class="wu-text-col">
        <h2 class="wu-heading">
          <span class="wu-italic">Kenapa</span>
          <span class="wu-bold">SPARKLIN<span class="wu-q">?</span></span>
        </h2>
        <p class="wu-sub">Lima hal yang kami pegang sejak hari pertama buka.</p>
      </div>

      <div class="wu-pills-col">
        <div class="wu-row-2">
          <div class="wu-pill wu-outline">
            Respon Cepat<br />&<br />Ramah
          </div>
          <div class="wu-pill wu-solid">
            Ramah<br />Lingkungan
          </div>
        </div>

        <div class="wu-pill wu-solid wu-full">
          Jaminan Selesai Tepat Waktu
        </div>

        <div class="wu-row-2">
          <div class="wu-pill wu-outline">
            Harga<br />Terjangkau
          </div>
          <div class="wu-pill wu-outline">
            Kenyamanan<br />Pelanggan
          </div>
        </div>

      </div>
    </div>
  </div>
</section>

<style is:global>
.why-us-section {
  padding: 90px 0;
  background: linear-gradient(160deg, var(--color-secondary) 0%, #29603d 55%, var(--color-primary) 100%);
  color: #ffffff;
  position: relative;
}

.wu-container {
  width: min(1200px, calc(100% - 48px));
  margin: 0 auto;
}

.wu-card {
  background: rgba(254, 254, 227, 0.12);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border: 1.5px solid rgba(254, 254, 227, 0.35);
  border-radius: 36px;
  padding: 60px 50px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 40px;
  box-shadow: 0 20px 50px rgba(11, 61, 30, 0.25);
  position: relative;
  overflow: hidden;
}

.wu-text-col, .wu-pills-col {
  position: relative;
  z-index: 2;
}

.wu-text-col {
  max-width: 480px;
}

.wu-heading {
  font-family: var(--font-sans);
  color: var(--color-cream);
  line-height: 1.05;
  margin-bottom: 16px;
}

.wu-italic {
  font-size: clamp(2.4rem, 5vw, 4.2rem);
  font-weight: 400;
  font-style: italic;
  display: block;
}

.wu-bold {
  font-size: clamp(2.8rem, 5.8vw, 4.6rem);
  font-weight: 800;
  display: flex;
  align-items: baseline;
  letter-spacing: 0.02em;
  text-shadow: 0 16px 36px rgba(11, 61, 30, 0.6);
  margin-top: -0.6rem;
}

.wu-q {
  font-family: 'Montserrat', var(--font-sans);
  font-size: clamp(3.2rem, 7vw, 5.5rem);
  font-weight: 800;
  color: var(--color-cream);
  margin-left: 2px;
}

.wu-sub {
  color: #eaf3ec;
  font-size: 1.05rem;
  font-weight: 400;
  line-height: 1.6;
}

.wu-pills-col {
  display: flex;
  flex-direction: column;
  gap: 14px;
  width: 480px;
  flex-shrink: 0;
}

.wu-row-2 {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14px;
}

.wu-pill {
  border-radius: 28px;
  text-align: center;
  font-weight: 600;
  font-size: 1.05rem;
  line-height: 1.35;
  padding: 18px 16px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: var(--font-sans);
  transition: transform 0.2s ease, box-shadow 0.2s ease;
  min-width: 0;
  box-sizing: border-box;
}

.wu-pill:hover {
  transform: translateY(-3px);
  box-shadow: 0 10px 24px rgba(0, 0, 0, 0.15);
}

.wu-outline {
  border: 1.5px solid var(--color-cream);
  color: var(--color-cream);
  background: rgba(254, 254, 227, 0.08);
}

.wu-solid {
  background: var(--color-cream);
  color: var(--color-primary);
  font-weight: 700;
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
}

.wu-full {
  width: 100%;
  padding: 18px 20px;
}

@media (max-width: 1024px) {
  .why-us-section {
    padding: 70px 0;
  }

  .wu-card {
    flex-direction: column;
    padding: 46px 34px;
    text-align: center;
    gap: 32px;
    border-radius: 28px;
  }

  .wu-text-col {
    max-width: 100%;
  }

  .wu-bold {
    justify-content: center;
  }

  .wu-pills-col {
    width: 100%;
    max-width: 500px;
  }

  .wu-pill {
    font-size: 0.98rem;
    padding: 16px 12px;
    border-radius: 24px;
  }
}

@media (max-width: 640px) {
  .why-us-section {
    padding: 50px 0 60px;
  }

  .wu-container {
    width: min(1200px, calc(100% - 32px));
  }

  .wu-card {
    padding: 32px 18px;
    border-radius: 22px;
    gap: 26px;
  }

  .wu-heading {
    margin-bottom: 12px;
  }

  .wu-sub {
    font-size: 0.92rem;
    line-height: 1.5;
  }

  .wu-pills-col {
    gap: 10px;
  }

  .wu-row-2 {
    gap: 10px;
  }

  .wu-pill {
    font-size: 0.84rem;
    padding: 13px 10px;
    border-radius: 18px;
    line-height: 1.3;
  }

  .wu-full {
    font-size: 0.88rem;
    padding: 13px 14px;
  }
}

@media (max-width: 420px) {
  .wu-card {
    padding: 28px 14px;
  }

  .wu-row-2 {
    grid-template-columns: 1fr;
    gap: 8px;
  }

  .wu-pill {
    font-size: 0.82rem;
    padding: 12px 12px;
  }

  .wu-full {
    font-size: 0.85rem;
  }
}
</style>
