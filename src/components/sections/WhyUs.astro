---
// WhyUs.astro
---

<section class="why-us-section" id="kenapa">
  <div class="wu-container">
    <div class="wu-card">
      <!-- Left Column: Typography -->
      <div class="wu-text-col">
        <h2 class="wu-heading">
          <span class="wu-italic">Kenapa</span>
          <span class="wu-bold">SPARKLIN<span class="wu-q">?</span></span>
        </h2>
        <p class="wu-sub">Lima hal yang kami pegang sejak hari pertama buka.</p>
      </div>

      <!-- Right Column: Pills -->
      <div class="wu-pills-col">
        
        <!-- Row 1 -->
        <div class="wu-row-2">
          <div class="wu-pill wu-outline">
            Respon Cepat<br />&<br />Ramah
          </div>
          <div class="wu-pill wu-solid">
            Ramah<br />Lingkungan
          </div>
        </div>

        <!-- Row 2 -->
        <div class="wu-pill wu-solid wu-full">
          Jaminan Selesai Tepat Waktu
        </div>

        <!-- Row 3 -->
        <div class="wu-row-2">
          <div class="wu-pill wu-outline">
            Harga<br />Terjangkau
          </div>
          <div class="wu-pill wu-outline">
            Kenyamanan<br />Pelanggan
          </div>
        </div>

      </div>
    </div>
  </div>
</section>

<style is:global>
.why-us-section {
  padding: 120px 0;
  background: url('/images/2fade.png') center / 135% no-repeat;
  background-color: #467656; /* Fallback color */
}

.wu-container {
  max-width: 1400px;
  margin: 0 auto;
  padding: 30px 24px;
}

.wu-card {
  background: rgba(255, 255, 255, 0.08); /* Glassmorphism tint */
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border: 1px solid rgba(255, 255, 255, 0.2);
  border-radius: 40px;
  padding: 70px 70px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 40px;
  box-shadow: 0 20px 50px rgba(0, 0, 0, 0.1);
  position: relative;
  overflow: hidden;
}

/* Subtle diagonal shadow effect using the requested image */
.wu-card::before {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 1;
  pointer-events: none;
  opacity: 0.8; /* Adjust if needed */
}

.wu-text-col, .wu-pills-col {
  position: relative;
  z-index: 2;
}

.wu-text-col {
  max-width: 500px;
}

.wu-heading {
  font-family: var(--font-sans);
  color: white;
  line-height: 1.1;
  margin-bottom: 20px;
}

.wu-italic {
  font-size: clamp(3rem, 6vw, 4.8rem);
  font-weight: 400;
  font-style: italic;
  display: block; 
}

.wu-bold {
  font-size: clamp(3.5rem, 6vw, 4.8rem);
  font-weight: 800;
  display: block;
  letter-spacing: 1px;
  text-shadow: 0 20px 40px rgba(38, 92, 61, 0.81);
  margin-top: -2rem;
}

.wu-q {
  font-family: 'Montserrat', var(--font-sans);
  font-size: 9rem;
  font-weight: 700;
}

.wu-sub {
  color: white;
  font-size: 1.15rem;
  font-weight: 400;
  line-height: 1.5;
}

.wu-pills-col {
  display: flex;
  flex-direction: column;
  gap: 16px;
  width: 500px;
  flex-shrink: 0;
}

.wu-row-2 {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16px;
}

.wu-pill {
  border-radius: 48px;
  text-align: center;
  font-weight: 400;
  font-size: 1.5rem;
  line-height: 1.4;
  padding: 24px 20px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: var(--font-sans);
  transition: transform 0.2s ease;
}

.wu-pill:hover {
  transform: translateY(-4px);
}

.wu-outline {
  border: 1.5px solid white;
  color: white;
}

.wu-solid {
  background: #fdfceb; /* Cream background */
  color: #3b7055; /* Dark green text */
}

.wu-full {
  width: 100%;
  padding: 24px;
}

@media (max-width: 992px) {
  .wu-card {
    flex-direction: column;
    padding: 50px 40px;
    text-align: center;
  }

  .wu-text-col {
    max-width: 100%;
  }

  .wu-pills-col {
    width: 100%;
    max-width: 500px;
  }
}

@media (max-width: 500px) {
  .wu-row-2 {
    grid-template-columns: 1fr;
  }
  .wu-italic, .wu-bold {
    font-size: 3rem;
  }
  .wu-pill {
    padding: 16px;
  }
}
</style>
