---
import { withBase } from '../../data/site';
---

<section class="showcase-section" id="showcase">
        <div class="section-shell">
          <div class="section-header-block text-center">
            <h2 class="section-title">
              <span class="italic-serif">Geser</span> untuk lihat bedanya.
            </h2>
            <p class="section-subtitle centered">
              Bandingkan kondisi sepatu bernoda dengan hasil treatment mendalam teknisi Sparklin. Geser kontrol slider ke kiri dan kanan.
            </p>
          </div>

          <!-- Draggable Before & After Card -->
          <div class="showcase-card-container">
            <!-- Header Badges -->
            <div class="showcase-floating-badges" aria-hidden="true">
              <div class="badge-pill badge-before">
                <span class="badge-indicator"></span>
                <span>sebelum</span>
              </div>
              <div class="badge-pill badge-after">
                <span>sesudah</span>
                <span class="badge-indicator active"></span>
              </div>
            </div>

            <!-- Slider Wrapper -->
            <div
              class="comparison-container"
              id="beforeAfterSlider"
              role="region"
              aria-label="Komparasi visual sebelum dan sesudah cuci sepatu"
            >
              <!-- Base (Clean After Image) -->
              <img
                src={withBase("/images/slider-shoe-box.png")}
                alt="Hasil sesudah perawatan sepatu Sparklin"
                class="slider-img slider-base-img"
                draggable="false"
              />

              <!-- Overlay (Dirty Before Image) with clip-path/width -->
              <div class="slider-overlay" id="comparisonOverlay">
                <img
                  src={withBase("/images/slider-shoe-box.png")}
                  alt="Kondisi sebelum perawatan sepatu Sparklin"
                  class="slider-img slider-overlay-img"
                  draggable="false"
                />
              </div>

              <!-- Draggable Divider Line & Handle -->
              <div
                class="slider-handle"
                id="sliderHandle"
                role="slider"
                aria-valuenow="50"
                aria-valuemin="0"
                aria-valuemax="100"
                aria-label="Geser untuk melihat perbedaan sebelum dan sesudah"
                tabindex="0"
              >
                <div class="handle-line"></div>
                <div class="handle-thumb">
                  <span class="thumb-arrow">◀</span>
                  <span class="thumb-bar">|</span>
                  <span class="thumb-arrow">▶</span>
                </div>
              </div>
            </div>

            <!-- Keyboard & Touch helper hint -->
            <div class="slider-hint">
              <span class="hint-icon">↔</span>
              <span>Tarik bulatan di tengah atau gunakan tombol panah keyboard (← / →)</span>
            </div>
          </div>
        </div>
      </section>

<style is:global>
.showcase-section {
padding: 95px 0;
    background: var(--color-bg-cream);
}

.showcase-card-container {
max-width: 820px;
    margin-inline: auto;
    margin-top: 36px;
}

.showcase-floating-badges {
display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 14px;
    padding-inline: 8px;
}

.badge-pill {
display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 14px;
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
}

.badge-before {
background: rgba(27, 56, 34, 0.08);
    color: #7a5028;
    border: 1px solid rgba(122, 80, 40, 0.2);
}

.badge-after {
background: var(--color-dark-green);
    color: #ffffff;
}

.badge-indicator {
width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #7a5028;
}

.badge-indicator.active {
background: var(--color-accent-lime);
}

.comparison-container {
position: relative;
    width: 100%;
    height: 380px;
    overflow: hidden;
    border-radius: 20px;
    box-shadow: 0 18px 45px rgba(27, 56, 34, 0.12);
    cursor: ew-resize;
    user-select: none;
    -webkit-user-select: none;
    background: #25402a;
    border: 2px solid rgba(27, 56, 34, 0.2);
}

.slider-img {
width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    pointer-events: none;
}

.slider-base-img {
position: absolute;
    inset: 0;
}

.slider-overlay {
position: absolute;
    top: 0;
    left: 0;
    bottom: 0;
    width: 50%;
    overflow: hidden;
    z-index: 2;
}

.slider-overlay-img {
width: 820px; /* matched to card container width so it doesn't squish */
    max-width: none;
    filter: saturate(0.65) brightness(0.85);
}

.slider-handle {
position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    width: 4px;
    transform: translateX(-50%);
    cursor: ew-resize;
    z-index: 3;
    display: flex;
    align-items: center;
    justify-content: center;
    outline: none;
}

.handle-line {
position: absolute;
    inset: 0;
    background: #ffffff;
    box-shadow: 0 0 8px rgba(0, 0, 0, 0.3);
}

.handle-thumb {
position: relative;
    z-index: 4;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: #ffffff;
    color: var(--color-dark-green);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 3px;
    font-size: 0.72rem;
    font-weight: 800;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.3);
    border: 2px solid var(--color-dark-green);
    transition: transform 0.15s ease;
}

.slider-handle:hover .handle-thumb {
transform: scale(1.1);
    box-shadow: 0 0 0 4px var(--color-accent-lime);
}

.slider-handle:focus-visible .handle-thumb {
transform: scale(1.1);
    box-shadow: 0 0 0 4px var(--color-accent-lime);
}

.thumb-bar {
opacity: 0.4;
}

.slider-hint {
display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--color-text-muted);
    margin-top: 16px;
    text-align: center;
}

.hint-icon {
font-weight: 700;
    color: var(--color-dark-green);
}

@media (max-width: 768px) {
  .comparison-container {

      height: 260px;
    
  }

  .slider-overlay-img {

      width: 100vw;
    
  }
}
</style>

<script>
// 2. Interactive Before & After Slider
      const slider = document.getElementById('beforeAfterSlider');
      const overlay = document.getElementById('comparisonOverlay');
      const handle = document.getElementById('sliderHandle');

      if (slider && overlay && handle) {
        let isDragging = false;

        const updatePosition = (percent: number) => {
          const clamped = Math.max(5, Math.min(95, percent));
          overlay.style.width = `${clamped}%`;
          handle.style.left = `${clamped}%`;
          handle.setAttribute('aria-valuenow', String(Math.round(clamped)));
        };

        const getPercent = (clientX: number) => {
          const rect = slider.getBoundingClientRect();
          return ((clientX - rect.left) / rect.width) * 100;
        };

        handle.addEventListener('mousedown', (e) => {
          isDragging = true;
          e.preventDefault();
        });

        window.addEventListener('mouseup', () => {
          isDragging = false;
        });

        window.addEventListener('mousemove', (e) => {
          if (!isDragging) return;
          updatePosition(getPercent(e.clientX));
        });

        // Touch support
        handle.addEventListener('touchstart', () => {
          isDragging = true;
        }, { passive: true });

        window.addEventListener('touchend', () => {
          isDragging = false;
        });

        window.addEventListener('touchmove', (e) => {
          if (!isDragging || !e.touches[0]) return;
          updatePosition(getPercent(e.touches[0].clientX));
        }, { passive: true });

        slider.addEventListener('click', (e) => {
          updatePosition(getPercent(e.clientX));
        });

        // Keyboard arrow navigation
        handle.addEventListener('keydown', (e) => {
          const cur = parseFloat(handle.getAttribute('aria-valuenow') || '50');
          if (e.key === 'ArrowLeft') {
            updatePosition(cur - 5);
            e.preventDefault();
          } else if (e.key === 'ArrowRight') {
            updatePosition(cur + 5);
            e.preventDefault();
          }
        });
      }
</script>
