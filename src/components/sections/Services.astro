---
import { services } from '../../data/site';
---

<section class="services-section" id="layanan">
  <div class="section-shell">
    <div class="section-header-block">
      <h2 class="section-title">
        <span class="italic-serif">Layanan</span> Sparklin
      </h2>
      <p class="section-subtitle">
        Tinggal pilih yang sesuai dengan kondisi sepatumu. Ragu? Konsultasikan ke kami secara gratis.
      </p>
    </div>

    <div class="services-grid">
      {services.map((item) => (
        <article class={`service-card ${item.isHero ? 'is-hero-card' : ''}`}>
          <div class="card-top">
            <span class="card-tag">{item.tag}</span>
            <span class="card-time">{item.time}</span>
          </div>

          <div class="card-body">
            <span class="card-alias">{item.alias}</span>
            <h3 class="card-name">{item.name}</h3>
            <p class="card-desc">{item.desc}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style is:global>
.services-section {
  padding: 90px 0;
  position: relative;
  background-color: var(--color-cream);
}

.services-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20px;
}

.service-card {
  background: #ffffff;
  border-radius: 24px;
  padding: 32px 26px;
  display: flex;
  flex-direction: column;
  border: 1.5px solid rgba(11, 61, 30, 0.12);
  transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  box-shadow: 0 4px 20px rgba(11, 61, 30, 0.05);
}

.service-card:hover {
  transform: translateY(-6px);
  box-shadow: 0 16px 36px rgba(11, 61, 30, 0.14);
  border-color: rgba(66, 139, 94, 0.4);
}

.service-card.is-hero-card {
  background: var(--color-secondary);
  color: var(--color-cream);
  border-color: var(--color-cream);
  transform: translateY(-4px);
  box-shadow: 0 16px 40px rgba(11, 61, 30, 0.25);
}

.service-card.is-hero-card:hover {
  transform: translateY(-8px);
  box-shadow: 0 20px 48px rgba(11, 61, 30, 0.35);
}

.service-card.is-hero-card .card-tag {
  background: var(--color-cream);
  color: var(--color-secondary);
  font-weight: 700;
}

.service-card.is-hero-card .card-name {
  color: var(--color-cream);
}

.service-card.is-hero-card .card-alias {
  color: rgba(254, 254, 227, 0.8);
}

.service-card.is-hero-card .card-time {
  color: rgba(254, 254, 227, 0.85);
}

.service-card.is-hero-card .card-desc {
  color: #ebf3ec;
}

.card-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 22px;
  gap: 8px;
}

.card-tag {
  font-family: var(--font-mono);
  font-size: 0.72rem;
  font-weight: 600;
  padding: 4px 10px;
  border-radius: 999px;
  background: rgba(66, 139, 94, 0.15);
  color: var(--color-secondary);
}

.card-time {
  font-family: var(--font-mono);
  font-size: 0.72rem;
  color: var(--color-secondary);
  font-weight: 600;
}

.card-alias {
  font-family: var(--font-mono);
  font-size: 0.75rem;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--color-secondary);
  display: block;
  margin-bottom: 6px;
  font-weight: 600;
}

.card-name {
  font-size: 1.45rem;
  font-weight: 800;
  letter-spacing: -0.02em;
  color: var(--color-secondary);
  margin-bottom: 12px;
  line-height: 1.2;
}

.card-desc {
  font-size: 0.88rem;
  line-height: 1.6;
  color: var(--color-text-muted);
}

@media (max-width: 1024px) {
  .services-section {
    padding: 70px 0;
  }

  .services-grid {
    grid-template-columns: repeat(2, 1fr);
    gap: 18px;
  }
}

@media (max-width: 640px) {
  .services-section {
    padding: 50px 0;
  }

  .services-grid {
    grid-template-columns: 1fr;
    gap: 16px;
  }

  .service-card {
    padding: 24px 20px;
    min-height: auto;
    border-radius: 20px;
  }

  .service-card.is-hero-card {
    transform: none;
  }

  .card-name {
    font-size: 1.3rem;
  }
}
</style>
