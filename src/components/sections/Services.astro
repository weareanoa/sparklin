---
import { services, whatsappBase } from '../../data/site';
---

<section class="services-section" id="layanan">
        <div class="section-shell">
          <div class="section-header-block">
            <h2 class="section-title">
              <span class="italic-serif">Layanan</span> Sparklin
            </h2>
            <p class="section-subtitle">
              Tinggal pilih yang sesuai dengan kondisi sepatumu. Ragu? Konsultasikan ke kami secara gratis.
            </p>
          </div>

          <div class="services-grid">
            {services.map((item) => {
              const waUrl = `${whatsappBase}${encodeURIComponent(`Halo Sparklin, saya ingin booking layanan ${item.name} (${item.price}).`)}`;
              return (
                <article class={`service-card ${item.isHero ? 'is-hero-card' : ''}`}>
                  <div class="card-top">
                    <span class="card-tag">{item.tag}</span>
                    <span class="card-time">{item.time}</span>
                  </div>

                  <div class="card-body">
                    <span class="card-alias">{item.alias}</span>
                    <h3 class="card-name">{item.name}</h3>
                    <p class="card-desc">{item.desc}</p>
                  </div>

                  <div class="card-footer">
                    <div class="price-box">
                      <span class="price-label">Mulai</span>
                      <strong class="price-value">{item.price}</strong>
                    </div>
                    <a
                      href={waUrl}
                      target="_blank"
                      rel="noreferrer"
                      class="card-action-btn"
                      aria-label={`Pesan layanan ${item.name}`}
                    >
                      <span>Pesan</span>
                      <span class="arrow">↗</span>
                    </a>
                  </div>
                </article>
              );
            })}
          </div>
        </div>
      </section>

<style is:global>
.services-section {
  padding: 90px 0;
  position: relative;
}

.services-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20px;
}

.service-card {
  background: var(--color-bg-card);
  border-radius: 24px;
  padding: 30px 24px;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-height: 380px;
  border: 1.5px solid rgba(43, 90, 63, 0.12);
  transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  box-shadow: 0 4px 20px rgba(27, 56, 34, 0.04);
}

.service-card:hover {
  transform: translateY(-6px);
  box-shadow: 0 16px 36px rgba(27, 56, 34, 0.12);
  border-color: rgba(43, 90, 63, 0.25);
}

.service-card.is-hero-card {
  background: linear-gradient(155deg, #346c45 0%, #255333 100%);
  color: #ffffff;
  border-color: rgba(176, 212, 58, 0.35);
  transform: translateY(-4px);
  box-shadow: 0 16px 40px rgba(27, 65, 38, 0.22);
}

.service-card.is-hero-card:hover {
  transform: translateY(-8px);
  box-shadow: 0 20px 48px rgba(27, 65, 38, 0.3);
}

.service-card.is-hero-card .card-tag {
  background: var(--color-accent-lime);
  color: #1a4025;
  font-weight: 700;
}

.service-card.is-hero-card .card-name {
  color: #ffffff;
}

.service-card.is-hero-card .card-alias {
  color: rgba(255, 255, 255, 0.75);
}

.service-card.is-hero-card .card-time {
  color: rgba(255, 255, 255, 0.7);
}

.service-card.is-hero-card .card-desc {
  color: #dbe7dc;
}

.service-card.is-hero-card .card-footer {
  border-top-color: rgba(255, 255, 255, 0.18);
}

.service-card.is-hero-card .price-label {
  color: rgba(255, 255, 255, 0.75);
}

.service-card.is-hero-card .price-value {
  color: #ffffff;
}

.service-card.is-hero-card .card-action-btn {
  background: #ffffff;
  color: #214b2d;
  font-weight: 700;
}

.service-card.is-hero-card .card-action-btn:hover {
  background: var(--color-accent-lime);
  color: #163820;
}

.card-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 22px;
  gap: 8px;
}

.card-tag {
  font-family: var(--font-mono);
  font-size: 0.72rem;
  font-weight: 600;
  padding: 4px 10px;
  border-radius: 999px;
  background: rgba(43, 90, 63, 0.1);
  color: #265333;
}

.card-time {
  font-family: var(--font-mono);
  font-size: 0.72rem;
  color: #557960;
  font-weight: 500;
}

.card-alias {
  font-family: var(--font-mono);
  font-size: 0.75rem;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: #5a8065;
  display: block;
  margin-bottom: 6px;
}

.card-name {
  font-size: 1.45rem;
  font-weight: 800;
  letter-spacing: -0.02em;
  color: #1e452a;
  margin-bottom: 12px;
  line-height: 1.2;
}

.card-desc {
  font-size: 0.88rem;
  line-height: 1.6;
  color: #43694f;
}

.card-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 26px;
  padding-top: 18px;
  border-top: 1px solid rgba(43, 90, 63, 0.12);
  gap: 8px;
}

.price-box {
  display: flex;
  flex-direction: column;
}

.price-label {
  font-family: var(--font-mono);
  font-size: 0.68rem;
  text-transform: uppercase;
  color: #5a8065;
  font-weight: 600;
}

.price-value {
  font-size: 1.35rem;
  font-weight: 800;
  color: #1e452a;
}

.card-action-btn {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  background: #275735;
  color: #ffffff;
  font-size: 0.85rem;
  font-weight: 700;
  padding: 8px 16px;
  border-radius: 999px;
  transition: all 0.2s ease;
  text-decoration: none;
}

.card-action-btn:hover {
  background: #1a3d24;
  transform: scale(1.04);
}

@media (max-width: 1024px) {
  .services-section {
    padding: 70px 0;
  }

  .services-grid {
    grid-template-columns: repeat(2, 1fr);
    gap: 18px;
  }
}

@media (max-width: 640px) {
  .services-section {
    padding: 50px 0;
  }

  .services-grid {
    grid-template-columns: 1fr;
    gap: 16px;
  }

  .service-card {
    padding: 24px 20px;
    min-height: auto;
    border-radius: 20px;
  }

  .service-card.is-hero-card {
    transform: none;
  }

  .card-name {
    font-size: 1.3rem;
  }

  .card-footer {
    margin-top: 20px;
    padding-top: 14px;
  }
}
</style>
