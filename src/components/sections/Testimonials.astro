---
import { testimonials, withBase } from '../../data/site';
---

<section class="testimonials-section" id="testimoni">
        <div class="section-shell">
          <div class="testi-header">
            <h2 class="section-title">
              <span class="italic-serif">TESTIMONI</span>
            </h2>
            <div class="testi-pill-badge">Dari mereka, untuk kamu.</div>
          </div>

          <div class="testimonials-grid">
            {testimonials.map((testi) => (
              <div class="testi-card">
                <div class="testi-quote-mark">“</div>
                <div class="testi-stars">{'★'.repeat(testi.stars)}</div>
                <blockquote class="testi-text">
                  "{testi.quote}"
                </blockquote>
                <div class="testi-author">
                  <img src={withBase(testi.avatar)} alt={testi.name} class="author-avatar" />
                  <div class="author-meta">
                    <strong class="author-name">{testi.name}</strong>
                    <span class="author-role">{testi.role}</span>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>

<style is:global>
.testimonials-section {
padding: 95px 0;
    background: var(--color-bg-cream);
}

.testi-header {
display: flex;
    align-items: center;
    gap: 20px;
    margin-bottom: 46px;
}

.testi-pill-badge {
background: var(--color-dark-green);
    color: #ffffff;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 600;
    padding: 6px 16px;
    border-radius: 999px;
}

.testimonials-grid {
display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
}

.testi-card {
background: #ffffff;
    border-radius: 24px;
    padding: 38px 30px;
    box-shadow: 0 12px 30px rgba(27, 56, 34, 0.06);
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    border: 1px solid var(--color-border-soft);
}

.testi-quote-mark {
font-family: var(--font-serif);
    font-size: 3.8rem;
    line-height: 1;
    color: rgba(27, 56, 34, 0.12);
    position: absolute;
    top: 20px;
    right: 28px;
}

.testi-stars {
color: #e59819;
    letter-spacing: 3px;
    font-size: 0.95rem;
    margin-bottom: 18px;
}

.testi-text {
font-size: 0.95rem;
    line-height: 1.7;
    color: var(--color-text-muted);
    margin-bottom: 26px;
    font-style: italic;
}

.testi-author {
display: flex;
    align-items: center;
    gap: 14px;
    padding-top: 18px;
    border-top: 1px solid var(--color-border-soft);
}

.author-avatar {
width: 48px;
    height: 48px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid var(--color-dark-green);
}

.author-meta {
display: flex;
    flex-direction: column;
}

.author-name {
font-size: 0.95rem;
    color: var(--color-dark-green);
}

.author-role {
font-size: 0.78rem;
    color: var(--color-text-muted);
}

@media (max-width: 1024px) {
  .testimonials-grid {

      grid-template-columns: 1fr;
    
  }
}
</style>
