---
import { testimonials, withBase } from '../../data/site';
---

<section class="testimonials-section" id="testimoni">
  <div class="section-shell">
    <div class="testi-header">
      <h2 class="testi-title">TESTIMONI</h2>
      <div class="testi-pill-badge">Dari mereka, untuk kamu.</div>
    </div>

    <div class="testimonials-grid">
      {testimonials.map((testi, i) => (
        <div class="testi-item">
          <div class={`testi-blob blob-${i}`}></div>
          
          <div class="testi-card">
            <div class="testi-avatar-wrapper">
              <img src={withBase(testi.avatar)} alt={testi.name} />
            </div>
            
            <div class="testi-quote-icon">
              <img src={withBase("/images/kutip.png")} alt="Quote" />
            </div>

            <h3 class="testi-author-name">{testi.name.toUpperCase()}</h3>
            <p class="testi-text">{testi.quote}</p>
          </div>

          <div class="testi-stars-pill">
            <span class="star">★</span>
            <span class="star">★</span>
            <span class="star">★</span>
            <span class="star">★</span>
            <span class="star">★</span>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style is:global>
.testimonials-section {
  padding: 100px 0 110px;
  background: var(--color-cream);
  overflow: hidden;
  position: relative;
}

.testi-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 80px;
  text-align: center;
}

.testi-title {
  font-family: var(--font-sans);
  font-style: italic;
  font-weight: 800;
  font-size: clamp(2.6rem, 5.5vw, 3.8rem);
  color: var(--color-primary);
  letter-spacing: -1.5px;
  margin-bottom: 6px;
  text-transform: uppercase;
  line-height: 1;
}

.testi-pill-badge {
  background: linear-gradient(180deg, var(--color-secondary) 0%, var(--color-primary) 100%);
  color: var(--color-cream);
  font-family: var(--font-sans);
  font-size: 1rem;
  font-weight: 600;
  padding: 8px 48px;
  border-radius: 999px;
  box-shadow: 0 4px 14px rgba(11, 61, 30, 0.2);
}

.testimonials-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 120px;
  max-width: 1100px;
  margin: 0 auto;
}

.testi-item {
  position: relative;
  margin-top: 40px;
  margin-bottom: 25px;
  display: flex;
  flex-direction: column;
  width: 100%;
}

.testi-blob {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: var(--color-secondary);
  border-radius: 28px;
  z-index: 1;
  box-shadow: 0 16px 36px rgba(11, 61, 30, 0.25);
  transition: transform 0.3s ease;
}

.blob-0 { transform: rotate(12deg); }
.blob-1 { transform: rotate(-12deg); }
.blob-2 { transform: rotate(12deg); }

.testi-card {
  position: relative;
  background: #ffffff;
  border: 1.5px solid rgba(11, 61, 30, 0.12);
  border-radius: 28px;
  padding: 44px 26px 32px;
  height: 100%;
  z-index: 2;
  display: flex;
  flex-direction: column;
  text-align: left;
  box-shadow: 0 16px 40px rgba(0, 0, 0, 0.15);
}

.testi-avatar-wrapper {
  position: absolute;
  top: 0;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 80px;
  height: 80px;
  border-radius: 50%;
  border: 6px solid #ffffff;
  background: #ffffff;
  overflow: hidden;
  box-shadow: 0 6px 18px rgba(0, 0, 0, 0.12);
}

.testi-avatar-wrapper img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.testi-quote-icon {
  margin-bottom: 10px;
  margin-top: 0;
}

.testi-quote-icon img {
  width: 36px;
  height: auto;
  object-fit: contain;
}

.testi-author-name {
  font-family: var(--font-sans);
  font-size: 1.1rem;
  font-weight: 800;
  color: var(--color-primary);
  margin-bottom: 8px;
  letter-spacing: 0.5px;
}

.testi-text {
  font-size: 0.92rem;
  line-height: 1.6;
  color: var(--color-text-muted);
  font-weight: 500;
  flex: 1;
  text-align: left;
}

.testi-stars-pill {
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translate(-50%, 50%);
  background: #ffffff;
  padding: 8px 22px;
  border-radius: 999px;
  display: flex;
  gap: 6px;
  align-items: center;
  z-index: 3;
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.22);
  border: 1px solid rgba(11, 61, 30, 0.1);
}

.testi-stars-pill .star {
  color: var(--color-primary);
  font-size: 1.15rem;
}

.testi-stars-pill .star:nth-child(3) {
  font-size: 1.55rem;
  transform: translateY(-2px);
}

.testi-item:nth-child(2) .testi-blob {
  background: var(--color-primary);
}

.testi-item:nth-child(2) .star {
  color: var(--color-primary);
}

@media (max-width: 1024px) {
  .testimonials-section {
    padding: 70px 0 85px;
  }

  .testi-header {
    margin-bottom: 60px;
  }

  .testimonials-grid {
    grid-template-columns: 1fr;
    gap: 80px;
    max-width: 440px;
  }

  .blob-0 { transform: rotate(7deg); }
  .blob-1 { transform: rotate(-7deg); }
  .blob-2 { transform: rotate(7deg); }
}

@media (max-width: 640px) {
  .testimonials-section {
    padding: 50px 0 65px;
  }

  .testi-header {
    margin-bottom: 50px;
  }

  .testi-pill-badge {
    padding: 7px 24px;
    font-size: 0.88rem;
    max-width: calc(100% - 32px);
    text-align: center;
  }

  .testimonials-grid {
    gap: 70px;
    max-width: 100%;
    padding-inline: 10px;
  }

  .testi-item {
    margin-top: 30px;
    margin-bottom: 20px;
  }

  .testi-card {
    padding: 38px 20px 28px;
    border-radius: 22px;
  }

  .testi-blob {
    border-radius: 22px;
  }

  .blob-0 { transform: rotate(5deg); }
  .blob-1 { transform: rotate(-5deg); }
  .blob-2 { transform: rotate(5deg); }

  .testi-avatar-wrapper {
    width: 68px;
    height: 68px;
    border-width: 5px;
  }

  .testi-author-name {
    font-size: 1rem;
  }

  .testi-text {
    font-size: 0.88rem;
    line-height: 1.5;
  }

  .testi-stars-pill {
    padding: 6px 18px;
    gap: 5px;
  }

  .testi-stars-pill .star {
    font-size: 1rem;
  }

  .testi-stars-pill .star:nth-child(3) {
    font-size: 1.35rem;
  }
}
</style>
