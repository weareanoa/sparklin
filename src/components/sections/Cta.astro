---
import { whatsappGeneral } from '../../data/site';
---

<section class="cta-section">
  <div class="section-shell">
    <div class="cta-banner">
      <div class="cta-bg-shadow"></div>
      <div class="cta-left">
        <h2 class="cta-title">
          <span class="italic-sans">Siap mulai,</span> <span style="font-weight: 400;">atau masih</span><br />
          <span style="font-weight: 400;">mau tanya?</span>
        </h2>
        <p class="cta-desc">
          Mulai gunakan layanan dan kirim foto sepatu lewat WhatsApp. Kami balas dengan rekomendasi layanan dan estimasi selesai.
        </p>
        <a href={whatsappGeneral} target="_blank" rel="noreferrer" class="cta-custom-btn whatsapp-btn">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="white"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.888-.788-1.487-1.761-1.66-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 0 0-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"/></svg>
          <span style="font-weight: 700; font-size: 1.1rem;">WhatsApp</span>
        </a>
      </div>

      <div class="cta-right">
        <a href="https://instagram.com/sparklinshoecare" target="_blank" rel="noreferrer" class="cta-custom-btn social-btn">
          <span class="social-title">Instagram</span>
          <span class="social-handle">@sparklinshoecare</span>
        </a>
        <a href="https://tiktok.com/@sparklinshoecare" target="_blank" rel="noreferrer" class="cta-custom-btn social-btn">
          <span class="social-title">TikTok</span>
          <span class="social-handle">@sparklinshoecare</span>
        </a>
      </div>
    </div>
  </div>
</section>

<style is:global>
.cta-section {
  padding: 95px 0 110px;
  background: #4e805f;
}

.cta-banner {
  background: #f9f8ed;
  border-radius: 40px;
  padding: 80px 70px;
  border: none;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 40px;
  position: relative;
  overflow: hidden;
}

.cta-bg-shadow {
  position: absolute;
  top: -50%;
  right: -10%;
  width: 60%;
  height: 200%;
  background: radial-gradient(circle, rgba(132, 148, 116, 0.5) 0%, transparent 65%);
  pointer-events: none;
  z-index: 1;
}

.cta-left {
  flex: 1;
  max-width: 650px;
  z-index: 2;
  position: relative;
}

.cta-right {
  display: flex;
  flex-direction: column;
  gap: 16px;
  width: 340px;
  z-index: 2;
  position: relative;
}

.cta-title {
  font-size: clamp(2rem, 4vw, 3.2rem);
  line-height: 1.1;
  letter-spacing: -0.02em;
  color: #428b5e;
  margin-bottom: 24px;
}
.cta-title span.italic-sans {
  font-style: italic;
  font-weight: 800;
}

.cta-desc {
  font-size: 1.05rem;
  color: #428b5e;
  margin-bottom: 40px;
  line-height: 1.6;
}

.cta-custom-btn {
  background: #428b5e;
  color: white;
  border-radius: 999px;
  text-decoration: none;
  transition: all 0.2s ease;
  box-shadow: 2px 4px 0px #d3d4c5;
  border: none;
}

.cta-custom-btn:hover {
  transform: translate(1px, 2px);
  box-shadow: 1px 2px 0px #d3d4c5;
}

.whatsapp-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 12px;
  padding: 12px 32px;
  width: max-content;
}

.social-btn {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  padding: 12px 32px;
  width: 100%;
}

.social-title {
  font-weight: 700;
  font-size: 1.05rem;
  line-height: 1.2;
}

.social-handle {
  font-size: 0.85rem;
  opacity: 0.9;
  font-weight: 400;
  line-height: 1.3;
}

@media (max-width: 900px) {
  .cta-banner {
    flex-direction: column;
    padding: 50px 30px;
    align-items: flex-start;
  }
  .cta-right {
    width: 100%;
  }
}
</style>
