---
import { whatsappGeneral } from '../../data/site';
---

<section class="cta-section">
  <div class="section-shell">
    <div class="cta-banner">
      <div class="cta-left">
        <h2 class="cta-title">
          <span class="italic-sans">Siap mulai,</span> <span style="font-weight: 400;">atau masih</span><br />
          <span style="font-weight: 400;">mau tanya?</span>
        </h2>
        <p class="cta-desc">
          Mulai gunakan layanan dan kirim foto sepatu lewat WhatsApp. Kami balas dengan rekomendasi layanan dan estimasi selesai.
        </p>
        <a href={whatsappGeneral} target="_blank" rel="noreferrer" class="cta-custom-btn whatsapp-btn">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="white"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.888-.788-1.487-1.761-1.66-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 0 0-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"/></svg>
          <span style="font-weight: 700; font-size: 1.1rem;">WhatsApp</span>
        </a>
      </div>

      <div class="cta-right">
        <a href="https://www.instagram.com/sparklinshoescare" target="_blank" rel="noreferrer" class="cta-custom-btn social-btn">
          <span class="social-title">Instagram</span>
          <span class="social-handle">@sparklinshoescare</span>
        </a>
        <a href="https://tiktok.com/@sparklinshoecare" target="_blank" rel="noreferrer" class="cta-custom-btn social-btn">
          <span class="social-title">TikTok</span>
          <span class="social-handle">@sparklinshoecare</span>
        </a>
      </div>
    </div>
  </div>
</section>

<style is:global>
.cta-section {
  padding: 95px 0 110px;
  background: var(--color-secondary);
  position: relative;
}

.cta-banner {
  background: var(--color-cream);
  border-radius: 36px;
  padding: 65px 60px;
  border: 1.5px solid rgba(254, 254, 227, 0.6);
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 40px;
  position: relative;
  overflow: hidden;
  box-shadow: 0 20px 50px rgba(11, 61, 30, 0.22);
}


.cta-left {
  flex: 1;
  max-width: 600px;
  z-index: 2;
  position: relative;
}

.cta-right {
  display: flex;
  flex-direction: column;
  gap: 14px;
  width: 320px;
  z-index: 2;
  position: relative;
  flex-shrink: 0;
}

.cta-title {
  font-size: clamp(2rem, 4vw, 3.1rem);
  line-height: 1.12;
  letter-spacing: -0.02em;
  color: var(--color-primary);
  margin-bottom: 18px;
}

.cta-title span.italic-sans {
  font-style: italic;
  font-weight: 800;
}

.cta-desc {
  font-size: 1.02rem;
  color: var(--color-text-muted);
  margin-bottom: 32px;
  line-height: 1.6;
}

.cta-custom-btn {
  background: var(--color-primary);
  color: var(--color-cream);
  border-radius: 999px;
  text-decoration: none;
  transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  box-shadow: 0 4px 14px rgba(11, 61, 30, 0.2);
  border: none;
  box-sizing: border-box;
}

.cta-custom-btn:hover {
  background: var(--color-forest-deep);
  transform: translateY(-2px);
  box-shadow: 0 8px 20px rgba(11, 61, 30, 0.3);
}

.cta-custom-btn:active {
  transform: scale(0.98);
}

.whatsapp-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  padding: 13px 30px;
  font-weight: 700;
  font-size: 1.05rem;
  width: max-content;
}

.social-btn {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  padding: 12px 28px;
  width: 100%;
}

.social-title {
  font-weight: 700;
  font-size: 1rem;
  line-height: 1.2;
}

.social-handle {
  font-size: 0.82rem;
  opacity: 0.88;
  font-weight: 400;
  line-height: 1.3;
}

@media (max-width: 900px) {
  .cta-section {
    padding: 70px 0;
  }

  .cta-banner {
    flex-direction: column;
    padding: 46px 32px;
    align-items: stretch;
    gap: 32px;
    border-radius: 28px;
  }

  .cta-left {
    max-width: 100%;
  }

  .cta-right {
    width: 100%;
  }

  .whatsapp-btn {
    width: 100%;
  }
}

@media (max-width: 640px) {
  .cta-section {
    padding: 50px 0 60px;
  }

  .cta-banner {
    padding: 32px 18px;
    border-radius: 22px;
    gap: 24px;
  }

  .cta-title {
    font-size: clamp(1.8rem, 6.5vw, 2.3rem);
    margin-bottom: 12px;
  }

  .cta-desc {
    font-size: 0.9rem;
    margin-bottom: 24px;
  }

  .whatsapp-btn {
    padding: 12px 20px;
    font-size: 0.95rem;
    width: 100%;
  }

  .social-btn {
    padding: 10px 20px;
  }

  .social-title {
    font-size: 0.92rem;
  }

  .social-handle {
    font-size: 0.78rem;
  }
}
</style>
