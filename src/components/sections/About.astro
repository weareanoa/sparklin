---
import { withBase } from '../../data/site';
---

<section class="about-section" id="tentang">
        <div class="section-shell">
          <div class="about-top-grid">
            <div class="about-brand-visual">
              <img
                src={withBase("/images/sparklin-logo-white.png")}
                alt="Sparklin Shoe Care Emblem"
                class="about-logo-img"
              />
            </div>
            <div class="about-brand-copy">
              <h2 class="about-heading">
                <span class="about-heading-serif">Tentang</span>
                <span class="about-heading-strong">Sparklin</span>
              </h2>
              <p class="about-lead">
                Sparklin menghadirkan layanan perawatan sepatu profesional dengan fokus pada kualitas dan efisiensi. Menggunakan teknik dan produk ramah lingkungan, kami membantu para pecinta sneakers dan profesional urban di Bandung menjaga rasa percaya diri mereka.
              </p>
            </div>
          </div>

          <div class="pillars-band">
            <div class="values-capsule">
              <div class="capsule-inner">
                <span class="capsule-item">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" stroke="none" aria-hidden="true"><path d="M12 2l1.8 5.3L19 9l-5.2 1.7L12 16l-1.8-5.3L5 9l5.2-1.7L12 2Zm7 12l.9 2.6L22.5 17l-2.6.9L19 20.5l-.9-2.6L15.5 17l2.6-.9L19 14ZM5 14l.9 2.6L8.5 17l-2.6.9L5 20.5l-.9-2.6L1.5 17l2.6-.9L5 14Z"/></svg>
                  Ramah Lingkungan
                </span>
                <span class="capsule-item">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" stroke="none" aria-hidden="true"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/><path d="M12 7.5 10.8 10H8.5l2 1.9L9.8 14l2.2-1.2 2.2 1.2-.7-2.1 2-1.9h-2.3L12 7.5Z" fill="var(--color-secondary)"/></svg>
                  Kebersihan
                </span>
                <span class="capsule-item">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M15 9h-4.5a1.75 1.75 0 1 0 0 3.5h3a1.75 1.75 0 1 1 0 3.5H9"/><path d="M12 7v2M12 15v2"/></svg>
                  Harga Bersahabat
                </span>
              </div>
            </div>
          </div>

          <div class="pillars-card">
            <div class="pillar-column">
              <div class="pillar-header">
                <div class="pillar-icon" aria-hidden="true">
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
                </div>
                <h3 class="pillar-title">VISI</h3>
              </div>
              <p class="pillar-body">
                Menjadi pilihan utama mahasiswa dalam perawatan sepatu dengan memberikan layanan yang bersih, cepat, terjangkau, dan meningkatkan kepercayaan diri di setiap langkah.
              </p>
            </div>

            <div class="pillar-column pillar-divider">
              <div class="pillar-header">
                <div class="pillar-icon" aria-hidden="true">
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/><path d="M15 2H9a1 1 0 0 0-1 1v2a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V3a1 1 0 0 0-1-1Z"/><path d="M12 11h4"/><path d="M12 16h4"/><path d="M8 11h.01"/><path d="M8 16h.01"/></svg>
                </div>
                <h3 class="pillar-title">MISI</h3>
              </div>
              <p class="pillar-body">
                Kami menyediakan layanan perawatan sepatu yang cepat, efisien, dan terjangkau dengan menerapkan praktik ramah lingkungan dalam setiap prosesnya. Melalui layanan ini, kami juga berkomitmen untuk mengedukasi masyarakat tentang pentingnya menjaga kebersihan sepatu sebagai bagian dari membangun penampilan yang lebih rapi dan percaya diri.
              </p>
            </div>

            <div class="pillar-column">
              <div class="pillar-header">
                <div class="pillar-icon" aria-hidden="true">
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="6"/><path d="M15.477 12.89 17 22l-5-3-5 3 1.523-9.11"/></svg>
                </div>
                <h3 class="pillar-title">VALUE</h3>
              </div>
              <p class="pillar-body">
                Kami merupakan layanan Laundry Sepatu yang berorientasi pada kebersihan, kualitas, dan konsistensi melalui teknik terbaik pada setiap jenis layanan yang kami punya untuk semua jenis sepatu.
              </p>
            </div>
          </div>
        </div>
      </section>

<style is:global>
.about-section {
  background: linear-gradient(160deg, var(--color-secondary) 0%, #29603d 55%, var(--color-primary) 100%);
  color: #ffffff;
  padding: 90px 0;
  position: relative;
}

.about-top-grid {
  display: grid;
  grid-template-columns: 0.9fr 1.1fr;
  gap: 60px;
  align-items: center;
  margin-bottom: 80px;
}

.about-brand-visual {
  display: flex;
  justify-content: center;
  align-items: center;
}

.about-logo-img {
  width: min(340px, 100%);
  height: auto;
  object-fit: contain;
}

.about-brand-copy {
  display: flex;
  flex-direction: column;
  gap: 18px;
}

.about-heading {
  display: flex;
  flex-direction: column;
  gap: 2px;
  line-height: 1.05;
  color: var(--color-cream);
}

.about-heading-serif {
  font-family: var(--font-serif);
  font-style: italic;
  font-weight: 600;
  font-size: clamp(2.4rem, 4.4vw, 4.2rem);
  letter-spacing: -0.02em;
}

.about-heading-strong {
  font-weight: 800;
  font-size: clamp(2.4rem, 4.4vw, 4.2rem);
  letter-spacing: -0.03em;
}

.about-lead {
  font-size: 1.05rem;
  line-height: 1.7;
  color: #eef5e7;
  max-width: 60ch;
}

.pillars-band {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 24px;
  margin-bottom: -28px;
  padding-inline: 16px;
  width: 100%;
}

.values-capsule {
  margin-inline: auto;
  background: var(--color-secondary);
  border: 3px solid var(--color-cream);
  border-radius: 44px;
  padding: 8px;
  box-shadow: 0 12px 30px rgba(0, 0, 0, 0.18);
  max-width: 100%;
}

.capsule-inner {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  background: var(--color-secondary);
  border: 2px solid rgba(254, 254, 227, 0.85);
  border-radius: 36px;
  padding: 10px 18px;
}

.capsule-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6px;
  padding: 6px 20px;
  font-size: 0.95rem;
  font-weight: 600;
  color: var(--color-cream);
  white-space: nowrap;
  text-align: center;
}

.capsule-item svg {
  width: 20px;
  height: 20px;
  flex-shrink: 0;
}

.pillars-card {
  background: var(--color-cream);
  border-radius: 32px;
  padding: 60px 48px 48px;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 36px;
  box-shadow: 0 20px 50px rgba(0, 0, 0, 0.15);
}

.pillar-column {
  display: flex;
  flex-direction: column;
  gap: 14px;
}

.pillar-divider {
  border-inline: 1px solid rgba(11, 61, 30, 0.15);
  padding-inline: 36px;
}

.pillar-header {
  display: flex;
  align-items: center;
  gap: 10px;
}

.pillar-icon {
  display: grid;
  place-items: center;
  color: var(--color-secondary);
}

.pillar-title {
  font-size: 1.5rem;
  font-weight: 800;
  letter-spacing: 0.03em;
  color: var(--color-secondary);
}

.pillar-body {
  font-size: 0.92rem;
  line-height: 1.7;
  text-align: justify;
  color: #244b30;
}

@media (max-width: 1024px) {
  .about-section {
    padding: 70px 0;
  }

  .about-top-grid {
    grid-template-columns: 1fr;
    text-align: center;
    gap: 24px;
    margin-bottom: 50px;
  }

  .about-brand-visual {
    max-width: 220px;
    margin-inline: auto;
  }

  .about-logo-img {
    width: 100%;
    max-width: 220px;
  }

  .about-brand-copy {
    gap: 14px;
    align-items: center;
  }

  .about-heading {
    align-items: center;
  }

  .pillars-band {
    margin-bottom: -24px;
    padding-inline: 8px;
  }

  .values-capsule {
    max-width: 580px;
    width: 100%;
    border-radius: 28px;
    padding: 6px;
  }

  .capsule-inner {
    width: 100%;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-radius: 24px;
    padding: 8px 10px;
    gap: 4px;
  }

  .capsule-item {
    padding: 6px 6px;
    font-size: 0.84rem;
    white-space: normal;
    text-align: center;
    line-height: 1.25;
  }

  .pillars-card {
    grid-template-columns: 1fr;
    gap: 28px;
    padding: 48px 28px 32px;
    border-radius: 28px;
  }

  .pillar-divider {
    border-inline: none;
    border-block: 1px solid rgba(11, 61, 30, 0.12);
    padding-inline: 0;
    padding-block: 28px;
  }
}

@media (max-width: 640px) {
  .about-section {
    padding: 50px 0 60px;
  }

  .about-top-grid {
    gap: 16px;
    margin-bottom: 36px;
  }

  .about-brand-visual {
    max-width: 150px;
    margin-inline: auto;
  }

  .about-logo-img {
    max-width: 150px;
  }

  .about-brand-copy {
    gap: 10px;
  }

  .about-heading-serif,
  .about-heading-strong {
    font-size: clamp(2rem, 6.5vw, 2.6rem);
  }

  .about-lead {
    font-size: 0.92rem;
    line-height: 1.6;
  }

  .pillars-band {
    margin-bottom: -20px;
    padding-inline: 0;
    width: 100%;
  }

  .values-capsule {
    width: 100%;
    max-width: 100%;
    border: 2.5px solid var(--color-cream);
    border-radius: 20px;
    padding: 4px;
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.16);
  }

  .capsule-inner {
    width: 100%;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border: 1.5px solid rgba(254, 254, 227, 0.85);
    border-radius: 16px;
    padding: 8px 3px;
    gap: 2px;
  }

  .capsule-item {
    padding: 2px 2px;
    font-size: 0.72rem;
    font-weight: 600;
    gap: 4px;
    white-space: normal;
    text-align: center;
    line-height: 1.2;
    word-break: break-word;
  }

  .capsule-item svg {
    width: 17px;
    height: 17px;
  }

  .pillars-card {
    padding: 38px 16px 24px;
    border-radius: 22px;
    gap: 20px;
  }

  .pillar-divider {
    padding-block: 20px;
  }

  .pillar-header {
    gap: 8px;
  }

  .pillar-title {
    font-size: 1.25rem;
  }

  .pillar-body {
    font-size: 0.88rem;
    line-height: 1.6;
    text-align: left;
  }
}

@media (max-width: 380px) {
  .about-top-grid {
    gap: 12px;
    margin-bottom: 30px;
  }

  .about-brand-visual {
    max-width: 130px;
  }

  .about-logo-img {
    max-width: 130px;
  }

  .values-capsule {
    padding: 3px;
    border-radius: 18px;
  }

  .capsule-inner {
    padding: 6px 2px;
    border-radius: 14px;
  }

  .capsule-item {
    font-size: 0.65rem;
    gap: 3px;
  }

  .capsule-item svg {
    width: 15px;
    height: 15px;
  }

  .pillars-card {
    padding: 34px 14px 20px;
  }
}
</style>
